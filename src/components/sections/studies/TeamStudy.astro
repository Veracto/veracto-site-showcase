---
import type { TeamStudy } from '@/content/lab-studies.schema';
import '@/components/sections/studies/team-study.css';
type Props = { content: TeamStudy; eyebrow?: string };
const { content: c, eyebrow = c.eyebrow } = Astro.props;
---

<section
  class="study team-study"
  id="study-team"
  data-study-speed="2"
  data-study-mobile-speed="3"
  aria-labelledby="team-study-title"
>
  <header class="study-heading">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="team-study-title">{c.title}</h2>
    <p>{c.intro}</p>
  </header>
  <ol class="handoff-roles">
    {c.roles.map((role, i) => (
      <li class="handoff-role" data-study-step data-duration="4300">
        <p class="role-name">
          <span class="role-dot" aria-hidden="true">
            {i + 1}
          </span>
          {role.label}
        </p>
        <h3 data-focus>{role.title}</h3>
        <svg
          class="study-motion handoff-track"
          viewBox="0 0 320 160"
          aria-hidden="true"
        >
          {i === 0 && (
            <g class="entry-artifact">
              <path
                class="artifact-page"
                data-fx="unfold"
                data-at="100"
                data-for="1100"
                d="M34 14h119v119H34Z"
              />
              <path
                class="artifact-ink ink"
                pathLength="1"
                data-fx="draw"
                data-at="450"
                data-for="900"
                d="M50 43h79m-79 17h65"
              />
              <path
                class="source-gap ink"
                pathLength="1"
                data-fx="draw"
                data-at="1450"
                data-for="900"
                d="M50 87h86v28H50Z"
              />
            </g>
          )}
          {i === 1 && (
            <g class="return-artifact">
              <path class="artifact-ghost" d="M198 18h110v113H198Z" />
              <path
                class="return-slip"
                data-fx="assemble"
                data-from="12,-8"
                data-at="200"
                data-for="1100"
                d="M27 38h131v92H27Z"
              />
              <path
                class="return-mark ink"
                pathLength="1"
                data-fx="draw"
                data-at="1100"
                data-for="1000"
                d="M47 63h90m-90 17h70m-70 17h78"
              />
            </g>
          )}
          {i === 2 && (
            <g class="revised-artifact">
              <path
                class="artifact-page"
                data-fx="unfold"
                data-at="100"
                data-for="1100"
                d="M34 14h119v119H34Z"
              />
              <path
                class="artifact-ink ink"
                pathLength="1"
                data-fx="draw"
                data-at="400"
                data-for="1000"
                d="M50 41h82m-82 15h67"
              />
              <path
                class="source-added ink"
                pathLength="1"
                data-fx="draw"
                data-at="1350"
                data-for="900"
                d="M50 79h83m-83 12h64m-64 12h73"
              />
              <path
                class="limit-tab"
                data-fx="stamp"
                data-at="2250"
                data-for="650"
                d="M113 116h47v17h-47Z"
              />
            </g>
          )}
          <path
            class="route-ink ink"
            pathLength="1"
            data-fx="draw"
            data-at="2250"
            data-for="900"
            d={
              i === 1
                ? 'M197 73H166m11-9-11 9 11 9'
                : 'M166 73h113m-10-9 10 9-10 9'
            }
          />
          <g
            class="packet temporary"
            data-fx="transfer"
            data-at="2250"
            data-for="1550"
            data-from={i === 1 ? '180,0' : '-150,0'}
          >
            <path d={i === 1 ? 'M33 58h32v36H33Z' : 'M250 58h32v36h-32Z'} />
            <path d={i === 1 ? 'M40 69h18m-18 9h13' : 'M257 69h18m-18 9h13'} />
          </g>
          <g class="mobile-handoff-direction">
            <path
              class="mobile-route-ink ink"
              pathLength="1"
              data-fx="draw"
              data-at="1500"
              data-for="1000"
              d={
                i === 1
                  ? 'M290 128h-35q-25 0-25-25V29m-9 9 9-9 9 9'
                  : 'M160 104v43m-9-9 9 9 9-9'
              }
            />
            <path
              class="mobile-packet temporary"
              data-fx="transfer"
              data-from={i === 1 ? '0,42' : '0,-42'}
              data-at="1900"
              data-for="1250"
              d={i === 1 ? 'M218 57h24v28h-24Z' : 'M148 105h24v28h-24Z'}
            />
          </g>
        </svg>
        <p class="exchange-label">{c.exchange[i]}</p>
        <p class="role-note">{role.body}</p>
      </li>
    ))}
  </ol>
  <div class="team-protocol" data-study-step data-duration="3400">
    <h3 data-focus>{c.protocol}</h3>
    <ol class="protocol-fields study-motion">
      {c.fields.map((field, i) => (
        <li>
          <span
            class="field-outline"
            aria-hidden="true"
            data-fx="unfold"
            data-at={String(300 + i * 650)}
            data-for="650"
          />
          {field}
        </li>
      ))}
    </ol>
    <p>{c.next}</p>
  </div>
</section>
