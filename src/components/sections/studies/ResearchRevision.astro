---
import type { ResearchRevision } from '@/content/research-revision.schema';
import '@/components/sections/studies/research-revision.css';
type Props = { content: ResearchRevision; eyebrow?: string };
const { content, eyebrow = content.eyebrow } = Astro.props;
---

<section
  class="research-revision"
  id="research-revision"
  aria-labelledby="revision-title"
>
  <header class="revision-intro">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="revision-title">{content.title}</h2>
    <p>{content.intro}</p>
  </header>
  <ol class="revision-sequence">
    {content.chapters.map((chapter, index) => (
      <li
        class:list={['revision-chapter', `chapter-${chapter.id}`]}
        data-revision-chapter={chapter.id}
      >
        <header class="chapter-heading">
          <p>
            {String(index + 1).padStart(2, '0')} / {chapter.label}
          </p>
          <h3>{chapter.title}</h3>
        </header>
        <div class="revision-paper">
          <div class="paper-layer" aria-hidden="true" data-cue="paper" />
          <div
            class="paper-layer layer-back"
            aria-hidden="true"
            data-cue="back"
          />
          <blockquote class="paper-claim">
            {chapter.before && <span>{chapter.before} </span>}
            <span class="claim-focus">
              <span class="claim-wash" aria-hidden="true" data-cue="wash" />
              <span class="claim-copy">{chapter.focus}</span>
              <svg
                class="claim-ink"
                viewBox="0 0 300 12"
                preserveAspectRatio="none"
                aria-hidden="true"
              >
                <path data-cue="ink" pathLength="1" d="M3 7Q80 3 150 7T297 6" />
              </svg>
              <svg
                class="review-pen"
                viewBox="0 0 72 40"
                aria-hidden="true"
                data-cue="pen"
              >
                <path d="M3 3 20 7 66 27Q70 29 68 34L64 38 16 17Z" />
                <path d="m20 7-4 10M3 3l8 7m12 3 38 17" />
              </svg>
            </span>
            {chapter.after}
          </blockquote>
          <div class="paper-rule" aria-hidden="true" data-cue="rule" />
          <dl class="paper-field">
            <dt>{chapter.field}</dt>
            <dd>
              <span class="field-wash" aria-hidden="true" data-cue="field" />
              {chapter.value}
            </dd>
          </dl>
          <div class="reference-thread" aria-hidden="true">
            <span class="reference-anchor">{chapter.anchor}</span>
            <svg viewBox="0 0 300 64" preserveAspectRatio="none">
              <path
                class="thread-base"
                d="M2 32C70 32 55 8 135 8S211 50 290 32"
              />
              <path
                class="thread-ink"
                data-cue="thread"
                pathLength="1"
                d="M2 32C70 32 55 8 135 8S211 50 290 32"
              />
              <path class="thread-tip" data-cue="tip" d="m280 25 12 7-10 9" />
            </svg>
            <span class="reference-receiver" data-cue="receiver">
              <i />
              <i />
              <i />
            </span>
          </div>
          <p class="paper-foot">{chapter.foot}</p>
        </div>
      </li>
    ))}
  </ol>
  <p class="revision-disclosure">{content.disclosure}</p>
</section>
<script>
  import '@/scripts/studies/research-revision-player';
</script>
