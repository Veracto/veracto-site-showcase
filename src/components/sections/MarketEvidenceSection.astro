---
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { MarketEvidence } from '@/content/market-evidence.schema';

type Props = { content: MarketEvidence };
const { content } = Astro.props;
---

<section
  class="section market-evidence"
  id={content.id}
  aria-labelledby={`${content.id}-title`}
>
  <Container>
    <div class="evidence-layout">
      <SectionHeading
        id={`${content.id}-title`}
        eyebrow={content.eyebrow}
        title={content.title}
      />
      <figure>
        <p class="population">{content.population}</p>
        <div class="market-plot" data-market-plot>
          {content.bars.map((bar, index) => (
            <div class="market-row">
              <div class="row-heading">
                <span>{bar.label}</span>
                <strong>{bar.value}%</strong>
              </div>
              <svg
                class:list={['bar-track', { secondary: index > 0 }]}
                viewBox="0 0 100 2"
                preserveAspectRatio="none"
                role="img"
                aria-label={`${bar.label}: ${bar.value}%`}
              >
                <rect class="track" width="100" height="2" />
                <rect class="market-bar" width={bar.value} height="2" />
              </svg>
            </div>
          ))}
          <div class="scale" aria-hidden="true">
            {[0, 25, 50, 75, 100].map((value) => (
              <span>{value}%</span>
            ))}
          </div>
        </div>
        <figcaption>
          <a
            href={content.source.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            {content.source.label}
          </a>
          <p>{content.limitation}</p>
        </figcaption>
        {content.implication && (
          <p class="implication">{content.implication}</p>
        )}
        <a class="research-link" href={content.reference.href}>
          {content.reference.label}
        </a>
      </figure>
    </div>
  </Container>
</section>

<script>
  import '@/scripts/market-chart-motion';
</script>

<style>
  .market-evidence {
    background: var(--document);
  }
  .evidence-layout {
    display: grid;
    gap: 2rem;
  }
  .evidence-layout > :global(.section-heading) {
    align-self: start;
  }
  figure {
    margin: 0;
    min-width: 0;
  }
  .population,
  figcaption {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    line-height: 1.6;
  }
  .population {
    margin-bottom: 1.5rem;
  }
  .market-plot {
    display: grid;
    gap: 1.25rem;
  }
  .row-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    margin-bottom: 0.5rem;
    font-size: var(--text-sm);
  }
  strong {
    font-size: var(--text-xl);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
    line-height: 1;
  }
  .bar-track {
    display: block;
    width: 100%;
    height: 0.75rem;
    overflow: hidden;
  }
  .track {
    fill: var(--sage);
  }
  .market-bar {
    fill: var(--forest);
    transform-box: fill-box;
    transform-origin: left center;
  }
  [data-market-state='pending'] .market-bar {
    transform: scaleX(0);
  }
  .secondary .market-bar {
    fill: var(--chart-blue);
  }
  .scale {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }
  figcaption {
    margin-top: 1.5rem;
  }
  figcaption a {
    text-underline-offset: 0.2em;
  }
  figcaption p {
    margin-top: 0.5rem;
  }
  .implication {
    margin-top: 1.5rem;
    font-size: var(--text-md);
  }
  .research-link {
    display: inline-block;
    padding-block: 0.75rem;
    font-size: var(--text-sm);
    text-underline-offset: 0.2em;
  }
  @media (min-width: 60rem) {
    .evidence-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }
</style>
