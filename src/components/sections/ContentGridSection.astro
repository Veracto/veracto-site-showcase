---
import BenefitCard from '@/components/ui/BenefitCard.astro';
import Container from '@/components/ui/Container.astro';
import EditorialCard from '@/components/ui/EditorialCard.astro';
import DocumentationLink from '@/components/ui/DocumentationLink.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { SectionContent } from '@/content/site.schema';

type Props = {
  content: SectionContent;
  id?: string;
  tone?:
    'plain' | 'soft' | 'forest' | 'research' | 'research-team' | 'organisation';
  columns?: 2 | 3;
  layout?: 'grid' | 'ledger' | 'dossier' | 'benefits';
};

const {
  content,
  id,
  tone = 'plain',
  columns = 3,
  layout = 'ledger',
} = Astro.props;
---

<section
  class:list={[
    'content-section',
    'section',
    `tone-${tone}`,
    `layout-${layout}`,
  ]}
  id={id}
  aria-labelledby={`${id ?? 'content'}-title`}
>
  <Container>
    <SectionHeading
      id={`${id ?? 'content'}-title`}
      eyebrow={content.eyebrow}
      title={content.title}
      description={content.description}
    />
    <div class:list={['content-grid', `columns-${columns}`]}>
      {layout === 'benefits'
        ? content.items.map((item) => (
            <BenefitCard
              title={item.title}
              description={item.description}
              reference={item.reference}
            />
          ))
        : content.items.map((item, index) => {
            const supporting =
              content.supporting && index >= content.supporting.startAt;
            const Heading = supporting ? 'h4' : 'h3';
            return (
              <>
                {content.supporting && index === content.supporting.startAt && (
                  <h3 class="supporting-title">{content.supporting.title}</h3>
                )}
                <EditorialCard class={supporting ? 'supporting-card' : ''}>
                  {!supporting && (
                    <span class="item-number">{item.number}</span>
                  )}
                  <Heading>{item.title}</Heading>
                  <div class="item-description">
                    <p>{item.description}</p>
                    {item.reference && (
                      <DocumentationLink href={item.reference.href}>
                        {item.reference.label}
                      </DocumentationLink>
                    )}
                  </div>
                </EditorialCard>
              </>
            );
          })}
    </div>
  </Container>
</section>

<style>
  .content-section :global(.container),
  .content-grid,
  .content-grid :global(.card) {
    display: grid;
  }
  .layout-ledger .content-grid {
    gap: 0;
  }
  .layout-ledger .content-grid :global(.card) {
    border: 0;
    border-top: 1px solid var(--line-strong);
    border-radius: 0;
    background: transparent;
    padding-inline: 0;
    padding-block: 1.5rem;
  }
  .content-section.layout-benefits {
    background: var(--paper);
  }
  .content-section :global(.container) {
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }
  .content-grid {
    gap: 0.75rem;
  }
  .content-grid :global(.card) {
    align-content: start;
    gap: 0.85rem;
  }
  .item-number {
    color: var(--section-accent, var(--ink-muted));
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  h3,
  h4 {
    font-size: var(--text-lg);
    line-height: 1.25;
  }

  p {
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .tone-soft {
    background: var(--paper-deep);
  }

  .tone-forest {
    --reference-ink: var(--paper);
    --reference-hover: var(--lime);
    --navy-deep: var(--paper);
    --ink-muted: var(--on-dark-muted);
    --brass: var(--accent-soft);
    --oxblood: var(--accent-soft);
    --focus: var(--accent-soft);
    background: var(--forest);
    color: var(--paper);
    border-radius: 3rem 3rem 0 0;
  }

  .tone-forest .content-grid :global(.card) {
    background: transparent;
    border-color: var(--on-dark-muted);
  }

  .tone-research {
    --section-accent: var(--evidence-blue);
    background: var(--research-wash);
  }

  .tone-organisation {
    --section-accent: var(--adoption-violet);
    background: var(--organisation-wash);
  }

  .tone-research-team {
    --section-accent: var(--verification-green);
    background: var(--sage);
  }

  @media (min-width: 48rem) {
    .content-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .layout-ledger .content-grid {
      column-gap: 2rem;
    }
  }

  @media (min-width: 68rem) {
    .columns-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .layout-ledger {
      --section-heading-size: clamp(1.85rem, 2.5vw, 2.75rem);
    }
    .layout-ledger :global(.container) {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
    }
    .layout-ledger .content-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .layout-ledger .content-grid :global(.card) {
      grid-template-columns: 2rem minmax(0, 1fr);
    }
    .layout-ledger .item-description {
      grid-column: 2;
    }
  }
  .supporting-title {
    grid-column: 1 / -1;
    padding-block: 2rem 1rem;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .layout-ledger .content-grid :global(.supporting-card) {
    grid-template-columns: minmax(0, 1fr);
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--document);
    padding: 1.25rem;
    margin-bottom: 0.75rem;
  }
  .layout-ledger :global(.supporting-card) .item-description {
    grid-column: 1;
  }
  .supporting-title ~ :global(.supporting-card) h4 {
    font-size: var(--text-md);
  }
</style>
