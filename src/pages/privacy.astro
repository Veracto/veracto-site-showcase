---
import { privacyPage } from '@/content/en/contact';
import { chrome, locale } from '@/content/en/site';
import SiteLayout from '@/layouts/SiteLayout.astro';
import PrivacyPage from '@/views/privacy/PrivacyPage.astro';
---

<SiteLayout
  title={privacyPage.meta.title}
  description={privacyPage.meta.description}
  siteName={chrome.brand}
  lang={locale}
  skipLinkLabel={chrome.skipLinkLabel}
>
  <PrivacyPage chrome={chrome} page={privacyPage} />
</SiteLayout>
