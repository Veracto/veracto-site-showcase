---
import ButtonLink from '@/components/ui/ButtonLink.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import MotionRule from '@/components/ui/MotionRule.astro';
import type { HomePageDefinition } from '@/content/pages.schema';

type Props = { content: HomePageDefinition['approach'] };
const { content } = Astro.props;
---

<section
  class="approach-preview section"
  aria-labelledby="approach-preview-title"
>
  <Container>
    <SectionHeading
      id="approach-preview-title"
      eyebrow={content.eyebrow}
      title={content.title}
      description={content.description}
    />
    <ol>
      {content.steps.map((step) => (
        <li>
          <MotionRule />
          <span>{step.number}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
    <ButtonLink href={content.cta.href} variant="secondary">
      {content.cta.label}
    </ButtonLink>
  </Container>
</section>

<style>
  .approach-preview :global(.container) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 4rem);
  }
  .approach-preview {
    border-block: 1px solid var(--line);
    background: var(--canvas);
  }

  ol {
    display: grid;
    border-top: 1px solid var(--line-strong);
    list-style: none;
  }

  li {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.75rem;
    border-bottom: 1px solid transparent;
    padding-block: 1.15rem;
  }

  li > span {
    color: var(--ink-muted);
    font-family: var(--font-sans);
    font-size: var(--text-lg);
  }

  h3 {
    font-size: var(--text-lg);
  }

  p {
    margin-top: 0.2rem;
    color: var(--ink-muted);
  }

  :global(.button-link) {
    width: max-content;
  }

  @media (min-width: 48rem) {
    ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem;
    }

    li {
      min-height: 9rem;
      padding-block: 1.5rem;
    }
  }
</style>
