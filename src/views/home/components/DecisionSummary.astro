---
import type { HomePageDefinition } from '@/content/pages.schema';
type Props = { content: HomePageDefinition['hero'] };
const { content } = Astro.props;
---

<aside class="decision-summary" aria-labelledby="decision-summary-title">
  <h2 id="decision-summary-title">{content.modelTitle}</h2>
  <ol>
    {content.model.map((item) => (
      <li>
        <span class="step-number" aria-hidden="true">
          {item.number}
        </span>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
      </li>
    ))}
  </ol>
  <p>{content.modelGate}</p>
</aside>

<style>
  .decision-summary {
    display: grid;
    gap: 1.25rem;
    color: var(--forest);
    padding-block: 2rem;
  }
  h2 {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.4;
    letter-spacing: normal;
  }
  ol {
    position: relative;
    display: grid;
    gap: 0.85rem;
    list-style: none;
  }
  li {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.3rem 0.8rem;
    padding: 1.2rem;
    border-radius: 1.25rem;
    background: var(--document);
    color: var(--forest);
  }
  li:nth-child(2) {
    background: var(--accent-soft);
  }
  li:nth-child(3) {
    background: #ffb39e;
  }
  li + li::before {
    content: '';
    position: absolute;
    height: 0.85rem;
    width: 1px;
    background: var(--on-dark-muted);
    top: -0.85rem;
    left: 2.6rem;
  }
  h3 {
    font-size: var(--text-md);
    line-height: 1.25;
    letter-spacing: -0.025em;
  }
  .step-number {
    grid-row: span 2;
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 1;
  }
  li p {
    grid-column: 2;
    color: var(--forest);
  }
  p {
    font-size: var(--text-sm);
    color: var(--muted);
  }
  @media (min-width: 52rem) {
    ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    li + li::before {
      display: none;
    }
  }
</style>
