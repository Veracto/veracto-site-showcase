---
import StaticDiagram from '@/components/sections/staticDiagrams/StaticDiagram.astro';
import { staticDiagrams as diagramsEn } from '@/content/en/static-diagrams';
import { staticDiagrams as diagramsRu } from '@/content/en/static-diagrams';
import SiteFrame from '@/components/layout/SiteFrame.astro';
import ContentGridSection from '@/components/sections/ContentGridSection.astro';
import PageCallToAction from '@/components/ui/PageCallToAction.astro';
import IllustratedHero from '@/components/sections/IllustratedHero.astro';
import type { OrganisationsPageDefinition } from '@/content/pages.schema';
import type { SiteChrome } from '@/content/site.schema';
import MarketEvidenceSection from '@/components/sections/MarketEvidenceSection.astro';
import { businessEvidence as evidenceEn } from '@/content/en/market-evidence';
import { businessEvidence as evidenceRu } from '@/content/en/market-evidence';

type Props = { chrome: SiteChrome; page: OrganisationsPageDefinition };
const { chrome, page } = Astro.props;
const diagrams = chrome.locale === 'ru' ? diagramsRu : diagramsEn;
---

<SiteFrame
  heroLayout="viewport"
  headerTone="forest"
  chrome={chrome}
  currentPath={page.path}
>
  <IllustratedHero
    content={page.introduction}
    route="organisations"
    tone="forest"
    primaryCta={{
      ...page.callToAction,
      label: chrome.navigation.at(-1)!.label,
      href: '#contact',
    }}
    secondaryCta={page.documentation}
  />
  <StaticDiagram content={diagrams.organisation} />
  <MarketEvidenceSection
    content={chrome.locale === 'ru' ? evidenceRu : evidenceEn}
  />
  <ContentGridSection
    content={page.result}
    id="result"
    tone={page.tone}
    columns={2}
    layout="benefits"
  />
  <PageCallToAction id="contact" content={page.callToAction} />
</SiteFrame>
