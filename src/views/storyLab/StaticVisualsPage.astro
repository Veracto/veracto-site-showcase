---
import type { StaticVisuals } from '@/content/static-visuals.schema';
import StaticVisualStudies from '@/views/storyLab/sections/StaticVisualStudies.astro';
import '@/views/storyLab/lab-shell.css';
type Props = { content: StaticVisuals; locale: 'en' | 'ru' };
const { content, locale } = Astro.props;
---

<main class="cinema">
  <div class="cinema-top">
    <a href={`${locale === 'ru' ? '/ru' : ''}/visual-lab/`}>{content.back}</a>
    <a
      href={`${locale === 'en' ? '/ru' : ''}/visual-lab/static/`}
      lang={locale === 'en' ? 'ru' : 'en'}
    >
      {content.language}
    </a>
  </div>
  <h1>{content.title}</h1>
  <p class="intro-copy">{content.intro}</p>
  <p class="disclosure">{content.backgroundStatus}</p>
  <nav aria-label={content.navigation}>
    {content.studies.map((study) => (
      <a href={`#${study.id}`}>{study.label}</a>
    ))}
  </nav>
  <StaticVisualStudies content={content} />
</main>
